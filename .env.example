# Copy this file to .env and fill in your values. Never commit the real .env file.

# Google Gemini API key (free tier). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Default Gemini model (see centralized model registry in backend/app/ai)
GEMINI_DEFAULT_MODEL=gemini-3.8-flash

# Optional additional providers - only needed if you select an OpenAI or
# Anthropic model in AI Configuration. Leave blank to use Gemini only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Backend bind address/port (keep localhost for local-only use)
HOST=127.0.0.1
PORT=8000
